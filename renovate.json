{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests"
  ],
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "ignorePaths": [
    "web/dist/**"
  ],
  "gomod": {
    "postUpdateOptions": [
      "gomodTidy"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "GOLANGCI_VERSION in the Makefile (installed by `make tools`, used by CI).",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "GOLANGCI_VERSION \\?= (?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "github.com/golangci/golangci-lint/v2",
      "datasourceTemplate": "go"
    },
    {
      "customType": "regex",
      "description": "GOSEC_VERSION in the Makefile (installed by `make tools`, used by CI).",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "GOSEC_VERSION \\?= (?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "github.com/securego/gosec/v2",
      "datasourceTemplate": "go"
    },
    {
      "customType": "regex",
      "description": "GOSEC_XTOOLS_VERSION in the Makefile (installed by `make tools`, used by CI).",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "GOSEC_XTOOLS_VERSION \\?= (?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "golang.org/x/tools",
      "datasourceTemplate": "go"
    },
    {
      "customType": "regex",
      "description": "GOVULNCHECK_VERSION in the Makefile (installed by `make tools`, used by CI).",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "GOVULNCHECK_VERSION \\?= (?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "golang.org/x/vuln",
      "datasourceTemplate": "go"
    },
    {
      "customType": "regex",
      "description": "ACTIONLINT_VERSION in the Makefile (installed by `make tools`, used by CI).",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "ACTIONLINT_VERSION \\?= (?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "github.com/rhysd/actionlint",
      "datasourceTemplate": "go"
    },
    {
      "customType": "regex",
      "description": "KUBECONFORM_VERSION in the Makefile (installed by `make tools`, used by CI).",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "KUBECONFORM_VERSION \\?= (?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "github.com/yannh/kubeconform",
      "datasourceTemplate": "go"
    },
    {
      "customType": "regex",
      "description": "hadolint image used by `make ops-lint`.",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "HADOLINT_IMAGE \\?= (?<depName>hadolint/hadolint):(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "JS lint/format pins in pre-commit additional_dependencies (eslint ones are dormant, see README Tooling).",
      "managerFilePatterns": [
        "/^\\.pre-commit-config\\.yaml$/"
      ],
      "matchStrings": [
        "(?<depName>eslint|@eslint/js|typescript-eslint|globals|eslint-plugin-react-hooks|eslint-plugin-react-refresh|eslint-config-prettier|prettier)@(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "opencode-ai, installed by deploy/opencode/Dockerfile.",
      "managerFilePatterns": [
        "/^deploy/opencode/Dockerfile$/"
      ],
      "matchStrings": [
        "ARG OPENCODE_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "opencode-ai",
      "datasourceTemplate": "npm"
    }
  ]
}
