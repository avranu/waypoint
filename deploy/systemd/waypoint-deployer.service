# Pull-based deploys of Waypoint (WP-406): one run of ~/bin/waypoint-deployer
# (deploy/pull-deploy.sh). A systemd user unit on the production host,
# installed by deploy/setup-cd.sh; started by waypoint-deployer.timer.
[Unit]
Description=Waypoint deployer: deploy the newest release from main
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=%h/bin/waypoint-deployer
# A deploy builds the image and waits for health (and a rollback, again).
TimeoutStartSec=40min
